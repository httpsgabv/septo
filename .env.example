# Copy to .env (git-ignored). Defaults match local development.

# Public
APP_DOMAIN=localhost
APP_URL=https://localhost

# Caddy upstreams: dev servers on the host (default) or, in production, the standalone
# containers on the `septo` network, e.g. septo-api:3333 and septo-web:5173.
API_UPSTREAM=host.docker.internal:3333
WEB_UPSTREAM=host.docker.internal:5173

# API
API_PORT=3333
API_DOCS_ENABLED=true

# Web
WEB_PORT=5173
API_INTERNAL_URL=http://localhost:3333

# Postgres
POSTGRES_USER=septo
POSTGRES_PASSWORD=septo
POSTGRES_DB=septo
# Host port for the container (5433 avoids clashing with a locally installed Postgres)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://septo:septo@localhost:5433/septo
