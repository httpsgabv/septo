generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String
  displayName  String
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  lastLoginIp  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Note {
  id         String    @id @default(uuid()) @db.Uuid
  title      String
  body       String // markdown
  searchText String // title + body normalized (derived by the entity, never comes from the API)
  tags       String[]  @default([])
  pinnedAt   DateTime?
  archivedAt DateTime?
  remindAt   DateTime?
  createdAt  DateTime // no defaults: the domain owns both timestamps
  updatedAt  DateTime

  @@map("notes")
}
